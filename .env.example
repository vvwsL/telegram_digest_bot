TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token

# Получить на https://my.telegram.org → API development tools
TG_API_ID=12345678
TG_API_HASH=put-your-api-hash

OPENAI_API_KEY=put-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

ADMIN_IDS=123456789
TIMEZONE=Europe/Moscow

# Постов на первый запуск (до первого дайджеста)
HISTORY_LIMIT=30
# Постов на тему в один дайджест (лимит для LLM)
MAX_ITEMS_PER_TOPIC=10
SNIPPET_CHARS=280
DB_PATH=data/bot.db
