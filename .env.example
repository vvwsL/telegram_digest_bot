# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=put-your-telegram-bot-token

# OpenAI
OPENAI_API_KEY=put-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Telegram user ID администратора (можно несколько через запятую: 111,222)
ADMIN_IDS=123456789

# Необязательные настройки
TIMEZONE=Europe/Moscow
HISTORY_LIMIT=30      # постов максимум в первом дайджесте
MAX_ITEMS=10          # максимум постов в один дайджест
SNIPPET_CHARS=280     # длина сниппета поста
DB_PATH=data/bot.db
SCRAPE_INTERVAL=900  # секунд между запусками веб-парсера (по умолчанию 15 мин)
